# ==============================================================================
# Visual Consistency & Evidence Engine — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your custom API keys if desired.
#
# NOTE: The engine works fully offline out of the box using built-in demo fixtures
# and DuckDuckGo search fallback when external API keys are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. External Visual Evidence Search Providers (Optional)
# ------------------------------------------------------------------------------
# Primary Provider: Serper.dev (Google Images search API for candidate image discovery)
# Register at: https://serper.dev
SERPER_API_KEY=

# Fallback Provider: SerpApi (Optional)
SERPAPI_API_KEY=

# Fallback Provider: Google Custom Search Engine (Optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# ------------------------------------------------------------------------------
# 2. Frontend / API Configuration (Optional)
# ------------------------------------------------------------------------------
# Default API endpoint accessed by the frontend dashboard.
# In Docker or local single-port deployment, leave empty or set to http://localhost:8000
VITE_API_URL=http://localhost:8000
